+/// Hy4 standard DSA indexer: compute k = rope_tail(layernorm(wk(x))) and store into k_cache at pos..
+pub fn dsaKeys(m: *Model, ix: wt.DsaIndexer, x: u64, pos: u64, inv_freq: u64, n: usize) !void {
+    const k = &m.k.k;
+    const f = try m.buf(n * 128 * 4);
+    try m.proj(ix.wk, x, m.c.hidden, f, n);
+    const rows = try m.buf(n * 128 * 2);
+    try k.layerNorm(m.s, f, 128, ix.k_norm_w, ix.k_norm_b, rows, 128, n, 128, m.c.eps);
+    try m.k.mla.rope(m.s, .{ .x = rows + 64 * 2, .x_row = 128, .x_head = 0, .out = rows + 64 * 2, .o_row = 128, .o_head = 0 }, n, 1, pos, inv_freq, 1.0);
+    try k.put(m.s, ix.k_cache, rows, pos, n, 128);
+}
+
+/// Hy4 standard DSA indexer: 32 heads, dim 128, ReLU(q.k)*w over nk keys, top-2048 into tok/cnt.
+pub fn dsaRecalled(m: *Model, ix: wt.DsaIndexer, x: u64, qr: u64, pos: u64, inv_freq: u64, nk: usize, n: usize, tok: u64, cnt: u64) !void {
+    const k = &m.k.k;
+    const qf = try m.buf(n * 4096 * 4);
+    try m.proj(ix.q, qr, m.c.q_rank, qf, n);
+    const q = try m.buf(n * 4096 * 2);
+    try k.castRows(m.s, qf, 4096, q, 4096, n, 4096);
+    try m.k.mla.rope(m.s, .{ .x = q + 64 * 2, .x_row = 4096, .x_head = 128, .out = q + 64 * 2, .o_row = 4096, .o_head = 128 }, n, 32, pos, inv_freq, 1.0);
+    const w = try m.buf(n * 32 * 4);
+    try m.proj(ix.hw, x, m.c.hidden, w, n);
+    const scores = try m.buf(n * nk * 4);
+    try k.dsaScores(m.s, q, w, ix.k_cache, pos, scores, n, nk, 1.0 / @sqrt(32.0 * 128.0));
+    try k.dsaSelect(m.s, scores, tok, cnt, n, nk, pos, m.c.index_topk);
+    if (m.snap) |*sn| for (sn.layers[0..sn.n], 0..) |li, j| if (li == m.at_layer) try snapshot(m, sn, j, tok, cnt, n);
+}
